# JARVIS Environment Config — copy to .env and fill in your keys
# (.env is gitignored; never commit real keys)

# Force UTF-8 on Windows — prevents emoji crash in print()
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ── Ollama (local LLM) — override config.py defaults ──
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ── Football-Data.org (free: football-data.org/client/register) ──
FOOTBALL_API_KEY=

# ── NVD NIST API (free: nvd.nist.gov/developers/request-an-api-key) ──
NVD_API_KEY=

# ── VirusTotal (free: virustotal.com/gui/join-us) ──
VIRUSTOTAL_API_KEY=
